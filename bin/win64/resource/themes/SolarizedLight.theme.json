{
  "schema": 2,
  "name": "Solarized Light",
  "extends": "NDN",
  "palette": {
    "bgDeep": "#eee8d5",
    "bg": "#fdf6e3",
    "bg1": "#eee8d5",
    "bg2": "#ddd6c1",
    "line": "#93a1a1",
    "fg": "#586e75",
    "fg2": "#657b83",
    "mute": "#839496",
    "acc": "#268bd2",
    "accFg": "#fdf6e3",
    "hot": "#cb4b16",
    "cRed": "#a8231f",
    "cGreen": "#738000",
    "cYellow": "#8a6700",
    "cBlue": "#268bd2",
    "cMagenta": "#d33682",
    "cCyan": "#1f8a82",
    "cOrange": "#cb4b16"
  },
  "colors": {
    "desktop": {
      "bg": "bgDeep"
    },
    "window": {
      "fg": "fg",
      "bg": "bg",
      "borderFocus": "acc",
      "borderNormal": "line",
      "titleFgFocus": "accFg",
      "titleBgFocus": "acc",
      "titleFgNormal": "fg2",
      "titleBgNormal": "bg2",
      "closeAccent": "cRed"
    },
    "dialog": {
      "fg": "fg",
      "bg": "bg1",
      "border": "acc",
      "hotFg": "hot"
    },
    "button": {
      "fg": "fg",
      "bg": "bg2",
      "focusFg": "accFg",
      "focusBg": "acc",
      "hotFocusFg": "accFg"
    },
    "cursor": {
      "fg": "accFg",
      "bg": "acc",
      "idleBg": "bg2",
      "hotFg": "accFg",
      "markedFg": "bg",
      "markedBg": "cRed"
    },
    "mark": {
      "fg": "cRed",
      "bandBg": "bg2"
    },
    "file": {
      "dir": "cBlue",
      "archive": "cOrange",
      "executable": "cGreen",
      "media": "cMagenta",
      "hidden": "mute",
      "hiddenDir": "mute",
      "hiddenArchive": "mute",
      "hiddenExecutable": "mute",
      "hiddenMedia": "mute"
    },
    "status": {
      "fg": "fg",
      "bg": "bg1",
      "separator": "mute"
    },
    "toolbar": {
      "fg": "fg2",
      "bg": "bg1",
      "keyFg": "cBlue"
    },
    "tab": {
      "activeFg": "accFg",
      "activeBg": "acc",
      "normalFg": "mute",
      "normalBg": "bg1"
    },
    "panel": {
      "tabActiveFg": "accFg",
      "tabActiveBg": "acc",
      "tabNormalFg": "mute",
      "headerFg": "cBlue"
    },
    "scroll": {
      "fg": "line",
      "thumb": "acc"
    }
  },
  "markdown": {
    "h1": {
      "fg": "cBlue"
    },
    "h2": {
      "fg": "cYellow"
    },
    "h3to6": {
      "fg": "cGreen"
    },
    "bold": {
      "fg": "fg2"
    },
    "italic": {
      "fg": "cMagenta"
    },
    "boldItalic": {
      "fg": "cMagenta"
    },
    "strike": {
      "fg": "mute"
    },
    "inlineCode": {
      "fg": "cGreen",
      "bg": "bg1"
    },
    "codeBlock": {
      "fg": "fg",
      "bg": "bg1"
    },
    "quote": {
      "fg": "mute"
    },
    "listMarker": {
      "fg": "cYellow"
    },
    "hrule": {
      "fg": "line"
    },
    "link": {
      "fg": "cBlue"
    },
    "imageMarker": {
      "fg": "mute"
    },
    "tableBorder": {
      "fg": "line"
    },
    "tableHeader": {
      "fg": "cYellow"
    }
  },
  "attrs": {
    "hotFocus": [
      "underline"
    ]
  },
  "frames": {
    "window": "single",
    "dialog": "single",
    "panelActive": "single",
    "panelIdle": "single"
  },
  "fileColoring": [
    {
      "name": "Archives",
      "mask": "*.zip;*.rar;*.7z;*.tar;*.gz;*.tgz;*.bz2;*.xz;*.iso;*.cab;*.wim",
      "normal": {
        "fg": "@file.archive"
      }
    },
    {
      "name": "Executables",
      "mask": "*.exe;*.com;*.bat;*.cmd;*.msi;*.ps1;*.vbs",
      "normal": {
        "fg": "@file.executable"
      }
    },
    {
      "name": "Temporary",
      "mask": "*.tmp;*.bak;*.old",
      "normal": {
        "fg": "@file.hidden"
      }
    },
    {
      "name": "Documents",
      "mask": "*.doc;*.docx;*.rtf;*.txt",
      "normal": {
        "fg": "cCyan"
      }
    },
    {
      "name": "Object Pascal",
      "mask": "*.pas;*.dpr;*.dproj",
      "normal": {
        "fg": "cBlue"
      }
    },
    {
      "name": "Markdown",
      "mask": "*.md",
      "normal": {
        "fg": "cRed"
      }
    }
  ]
}

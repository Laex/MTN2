      "hotFg": "background",
      "markedBg": "yellow"
    },
    "mark": {
      "fg": "yellow",
      "bandBg": "currentLine"
    },
    "file": {
      "dir": "cyan",
      "archive": "orange",
      "executable": "green",
      "media": "pink",
      "hidden": "comment",
      "hiddenDir": "comment",
      "hiddenArchive": "comment",
      "hiddenExecutable": "comment",
      "hiddenMedia": "comment"
    },
    "status": {
      "fg": "foreground",
      "bg": "currentLine",
      "separator": "comment"
    },
    "toolbar": {
      "fg": "foreground",
      "bg": "currentLine",
      "keyFg": "pink"
    },
    "tab": {
      "activeFg": "background",
      "activeBg": "purple",
      "normalFg": "comment",
      "normalBg": "currentLine"
    },
    "panel": {
      "tabActiveFg": "background",
      "tabActiveBg": "purple",
      "tabNormalFg": "comment",
      "headerFg": "purple"
    },
    "scroll": {
      "fg": "comment",
      "thumb": "purple"
    }

    "boldItalic": {
      "fg": "pink"
    },
    "strike": {
      "fg": "comment"
    },
    "inlineCode": {
      "fg": "green",
      "bg": "currentLine"
    },
    "codeBlock": {
      "fg": "foreground",
      "bg": "currentLine"
    },
    "quote": {
      "fg": "comment"
    },
    "listMarker": {
      "fg": "yellow"
    },
    "hrule": {
      "fg": "comment"
    },
    "link": {
      "fg": "cyan"
    },
    "imageMarker": {
      "fg": "comment"
    },
    "tableBorder": {
      "fg": "comment"
    },
    "tableHeader": {
      "fg": "yellow"
    }
  },
  "attrs": {
    "hotFocus": [
      "underline"
    ]
  },
  "frames": {
    "window": "single",
    "dialog": "single",
    "panelActive": "single",
    "panelIdle": "single"

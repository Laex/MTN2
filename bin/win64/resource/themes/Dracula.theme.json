{
  "schema": 2,
  "name": "Dracula",
  "extends": "NDN",
  "palette": {
    "background": "#282A36",
    "currentLine": "#44475A",
    "foreground": "#F8F8F2",
    "comment": "#6272A4",
    "cyan": "#8BE9FD",
    "green": "#50FA7B",
    "orange": "#FFB86C",
    "pink": "#FF79C6",
    "purple": "#BD93F9",
    "red": "#FF5555",
    "yellow": "#F1FA8C",
    "idleCursor": "#3A3C4E"
  },
  "colors": {
    "desktop": {
      "bg": "background"
    },
    "window": {
      "fg": "foreground",
      "bg": "background",
      "borderFocus": "purple",
      "borderNormal": "comment",
      "titleFgFocus": "background",
      "titleBgFocus": "purple",
      "titleFgNormal": "comment",
      "titleBgNormal": "currentLine",
      "closeAccent": "red"
    },
    "dialog": {
      "fg": "foreground",
      "bg": "currentLine",
      "border": "purple",
      "hotFg": "orange"
    },
    "button": {
      "fg": "foreground",
      "bg": "currentLine",
      "focusFg": "background",
      "focusBg": "purple",
      "hotFocusFg": "background"
    },
    "cursor": {
      "fg": "background",
      "bg": "pink",

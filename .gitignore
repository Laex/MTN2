# Delphi / RAD Studio
*.dcu
*.dcp
*.dcpil
*.dsk
*.dti
*.drc
*.exe
*.dll
*.bpl
*.bpi
*.rsm
*.map
*.jdbg
*.local
*.identcache
*.tvsconfig
*.stat
*.dsv
*.~*
*.bak
*.ddp
*.cfg
*.dof
*.mes
*.otares
*.vlb
*.skincfg
*.groupproj.local
*.dproj.local
*.deployproj
*.app
*.dylib
*.so
*.a
*.o

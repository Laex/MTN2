*.ocx

# Compiled resources (keep project .rc; keep MTN2.res linked from dpr)
*.res
!src/MTN2.res
!*.rc
# MTN2Resource.rc -> MTN2.dres: rebuilt by build.ps1 and run-tests.ps1
*.dres

# Project build outputs (see MTN2.dproj: DCC_ExeOutput / DCC_DcuOutput)
/bin/*
# F1 help topics are sources, not build output
!/bin/help/
/dcu/
src/dcu/
src/tools/dcu/
src/tools/**/dcu/
src/tests/dcu/
src/tools/wasmtime/

# Rust plugin build trees
**/target/

# Platform / IDE build trees (any depth)
Win32/
Win64/
Android/
Android64/
iOSDevice*/
iOSSimulator/
OSX*/
Linux*/
__history/
__recovery/
modules/

# IDE / OS junk
.obsidian/
.DS_Store
Thumbs.db
desktop.ini

# Runtime / logs (local machine; not source)
*.log
*.tmp
*.temp
# `*.tmp` also matches the plugin folder name -- keep its sources
!src/plugins/mtn.tmp/
portable.dat

# MTN2 user data. Portable mode (portable.dat) writes it next to the exe,
# so a test or IDE build run outside bin/ would leave it in the tree: saved
# SSH hosts and users, visited folders, command history, file positions.
session.json
history.json
dialoghistory.json
dirsync-state.json
fileposition.json
filehistory.json
folderhistory.json
folderhotlist.json
sshconnections.json
workspaces.json
# ...the same names are dialog layouts in the sources -- keep those
!src/dialogs/*.json

# Keys, certificates, local secrets (SSH testing, release signing)
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.ppk
id_rsa*
id_ecdsa*
id_ed25519*

# Python (src/Assets/make_ico.py)
__pycache__/
*.py[cod]

# Local AI / editor tooling (repowise keeps API keys in .repowise/.env)
.zcode/
.vscode/
.repowise/
.claude/
.cursor/
.mcp.json

# Release packages (src/tools/package-release.ps1)
/dist/

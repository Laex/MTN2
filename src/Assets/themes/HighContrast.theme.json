{
  "schema": 2,
  "name": "High Contrast (accessibility)",
  "extends": "NDN",
  "palette": {
    "black": "#000000",
    "white": "#FFFFFF",
    "yellow": "#FFFF00",
    "cyan": "#00FFFF",
    "green": "#00FF00",
    "magenta": "#FF00FF",
    "orange": "#FF8000",
    "red": "#FF0000",
    "greyPanel": "#303030",
    "greyFg": "#C0C0C0",
    "navy": "#000080"

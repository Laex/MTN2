    "dialogTitle": [
      "bold"
    ],
    "check": [
      "bold"
    ],
    "tab": [
      "bold"
    ],
    "toolbar": [
      "bold"
    ],
    "status": [
      "bold"
    ],
    "menu": [
      "bold"
    ],
    "hot": [
      "underline"
    ],
    "hotFocus": [
      "underline"
    ]

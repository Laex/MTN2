{
  "profile": "NDN",
  "description": "Modern Terminal Navigator 2 (MTN2) User Keymap Configuration",
  "bindings": {
    "Help": { "key": "F1", "description": "Open Help / Hotkeys Dialog" },
    "Pack": { "key": "F1", "shift": true, "description": "Pack Selection to ZIP Archive" },
    "UserMenu": { "key": "F2", "description": "Open User Menu" },
    "Unpack": { "key": "F2", "shift": true, "description": "Extract / Unpack ZIP Archive" },
    "View": { "key": "F3", "description": "View File or Directory Size" },
    "Edit": { "key": "F4", "description": "Edit Text File" },
    "NewFile": { "key": "F4", "shift": true, "description": "Create New File" },
    "Copy": { "key": "F5", "description": "Copy Files / Directories" },
    "Move": { "key": "F6", "description": "Move Files / Directories" },
    "Rename": { "key": "F6", "shift": true, "description": "Rename File under cursor" },
    "CopyInPlace": { "key": "F5", "shift": true, "description": "Copy File under cursor into the same directory under a new name" },
    "MkDir": { "key": "F7", "description": "Create New Directory" },
    "CreateLink": { "key": "F7", "shift": true, "description": "Create Symlink / Hardlink / Junction" },
    "CompareFiles": { "key": "C", "ctrl": true, "alt": true, "description": "Compare files under both panel cursors" },
    "CompareFolders": { "key": "C", "ctrl": true, "shift": true, "description": "Select files that differ between the panels" },
    "ExternalView": { "key": "F3", "alt": true, "description": "View file in the external viewer" },
    "ExternalEdit": { "key": "F4", "alt": true, "description": "Edit file in the external editor" },
    "Checksums": { "key": "H", "ctrl": true, "alt": true, "description": "Calculate or verify file checksums" },
    "RecycleBin": { "key": "F8", "ctrl": true, "alt": true, "description": "Navigate to Recycle Bin" },
    "Restore": { "key": "R", "ctrl": true, "alt": true, "description": "Restore item under cursor from Recycle Bin" },
    "Delete": [
      { "key": "F8", "description": "Delete to Recycle Bin (F8)" },
      { "key": "Delete", "description": "Delete to Recycle Bin (Del)" }
    ],
    "Wipe": [
      { "key": "F8", "shift": true, "description": "Permanent Wipe Delete (Shift+F8)" },
      { "key": "Delete", "shift": true, "description": "Permanent Wipe Delete (Shift+Del)" }
    ],
    "Quit": { "key": "F10", "description": "Exit Application (F10)" },
    "Find": { "key": "F7", "alt": true, "description": "Find / Search Files" },
    "ColumnModes": { "key": "`", "ctrl": true, "description": "Column Display Mode Menu" },
    "InfoPanel": { "key": "L", "ctrl": true, "description": "Toggle Disk Info Panel on Adjacent Side" },
    "SwapPanels": { "key": "U", "ctrl": true, "description": "Swap Left and Right Panels" },
    "EqualizeOtherPanel": { "key": "]", "ctrl": true, "description": "Set other panel directory to active panel" },
    "EqualizeActivePanel": { "key": "[", "ctrl": true, "description": "Set active panel directory to other panel" },
    "SortMenu": { "key": "F12", "ctrl": true, "description": "Sort Options Menu" },
    "ConsoleToggle": [
      { "key": "O", "ctrl": true, "description": "Toggle Panel <-> Console Screen (Ctrl+O)" },
      { "key": "Esc", "description": "Toggle Panel <-> Console Screen (Esc)" }
    ],
    "DriveRoot": { "key": "\\", "ctrl": true, "description": "Navigate to Drive Root" },
    "DriveLeft": { "key": "F1", "alt": true, "description": "Change Left Drive" },
    "DriveRight": { "key": "F2", "alt": true, "description": "Change Right Drive" },
    "TogglePanelLeft": { "key": "F1", "ctrl": true, "description": "Show/Hide Left Panel" },
    "TogglePanelRight": { "key": "F2", "ctrl": true, "description": "Show/Hide Right Panel" },
    "Refresh": { "key": "R", "ctrl": true, "description": "Refresh Active Panel" },
    "SelectAll": { "key": "A", "ctrl": true, "description": "Select All Files" },
    "SetAttributes": { "key": "A", "ctrl": true, "shift": true, "description": "Set file attributes and owner" },
    "Properties": { "key": "Enter", "alt": true, "description": "Windows Properties window for the selection" },
    "InvertSelection": { "key": "I", "ctrl": true, "description": "Invert File Selection" },
    "HistoryBack": { "key": "Left", "alt": true, "description": "Directory History Back" },
    "HistoryForward": { "key": "Right", "alt": true, "description": "Directory History Forward" },
    "FolderHistory": { "key": "F12", "alt": true, "description": "Folder history dialog" },
    "FileHistory": { "key": "F11", "alt": true, "description": "History of files opened with F3/F4" },
    "CmdHistory": { "key": "F8", "alt": true, "description": "Command line history dialog" },
    "FolderHotlist": { "key": "D", "ctrl": true, "description": "Directory hotlist dialog" },
    "FolderHotlistAdd": { "key": "D", "ctrl": true, "alt": true, "description": "Add current directory to hotlist" },
    "WorkspaceLibrary": { "key": "D", "ctrl": true, "shift": true, "description": "Saved workspaces dialog" },
    "WorkspaceSave": { "key": "D", "ctrl": true, "alt": true, "shift": true, "description": "Save current workspace" },
    "SshConnections": { "key": "N", "ctrl": true, "alt": true, "shift": true, "description": "SSH/SFTP connections dialog" },
    "Associations": { "key": "A", "ctrl": true, "alt": true, "shift": true, "description": "File associations dialog" },
    "BranchView": { "key": "B", "ctrl": true, "description": "Flat/branch view of current directory subtree" },
    "LiveFilter": { "key": "F", "ctrl": true, "description": "Live filter panel rows by mask" },
    "SortByName": { "key": "F3", "ctrl": true, "description": "Sort Panel Items by Name" },
    "SortByExt": { "key": "F4", "ctrl": true, "description": "Sort Panel Items by Extension" },
    "SortByDate": { "key": "F5", "ctrl": true, "description": "Sort Panel Items by Modified Date" },
    "SortBySize": { "key": "F6", "ctrl": true, "description": "Sort Panel Items by File Size" },
    "SortUnsorted": { "key": "F7", "ctrl": true, "description": "Unsorted Panel Order" },
    "SortByCreated": { "key": "F8", "ctrl": true, "description": "Sort Panel Items by Creation Date" },
    "SortByAccessed": { "key": "F9", "ctrl": true, "description": "Sort Panel Items by Access Date" },
    "CopyFullPath": { "key": "Insert", "ctrl": true, "alt": true, "description": "Copy Full Path of Item(s) to Clipboard" },
    "InsertItemName": { "key": "Enter", "ctrl": true, "description": "Insert Selected Item Name into Command Line" },
    "InsertItemPath": { "key": "Enter", "ctrl": true, "shift": true, "description": "Insert Selected Item Path into Command Line" },
    "RunDetached": { "key": "Enter", "shift": true, "description": "Run File or Command in Detached OS Window" },
    "FocusCmdLine": { "key": "Down", "ctrl": true, "description": "Focus Command Line" },
    "NewTab": { "key": "T", "ctrl": true, "description": "Open New Panel Tab" },
    "CloseTab": { "key": "W", "ctrl": true, "description": "Close Active Panel Tab" },
    "NextTab": { "key": "Tab", "ctrl": true, "description": "Switch to Next Panel Tab" },
    "SelectByMask": { "key": "+", "description": "Select Files by Wildcard Mask" },
    "UnselectByMask": { "key": "-", "description": "Deselect Files by Wildcard Mask" },
    "DirSync": { "key": "S", "ctrl": true, "alt": true, "description": "Synchronize directories (one-way or two-way)" },
    "JobList": { "key": "J", "ctrl": true, "shift": true, "description": "Show background copy/delete job list" },
    "NewTerminal": { "key": "N", "ctrl": true, "shift": true, "description": "Open Terminal Workspace (profile picker)" },
    "SyncConsoleDir": { "key": "O", "ctrl": true, "shift": true, "description": "Sync directory between active panel and background console" },
    "SelectConsoleProfile": { "key": "O", "ctrl": true, "alt": true, "description": "Choose shell profile for the background console under the panels" },
    "ToggleHidden": { "key": "H", "ctrl": true, "description": "Show/Hide Hidden and System files in the active panel" },
    "ColumnBrief": { "key": "F1", "ctrl": true, "shift": true, "description": "Column Mode: Brief" },
    "ColumnSize": { "key": "F2", "ctrl": true, "shift": true, "description": "Column Mode: Size" },
    "ColumnDate": { "key": "F3", "ctrl": true, "shift": true, "description": "Column Mode: Date" },
    "ColumnFull": { "key": "F4", "ctrl": true, "shift": true, "description": "Column Mode: Full" },
    "ColumnCreated": { "key": "F5", "ctrl": true, "shift": true, "description": "Column Mode: Created" },
    "ColumnTypes": { "key": "F6", "ctrl": true, "shift": true, "description": "Column Mode: Types" },
    "ColumnCustom": { "key": "F7", "ctrl": true, "shift": true, "description": "Column Mode: Custom" },
    "EditCopy": [
      { "key": "C", "ctrl": true, "description": "Copy (text, or files/folders on panels)" },
      { "key": "Insert", "ctrl": true, "description": "Copy (Ctrl+Ins)" }
    ],
    "EditCut": [
      { "key": "X", "ctrl": true, "description": "Cut (text, or files/folders on panels)" },
      { "key": "Delete", "ctrl": true, "description": "Cut (Ctrl+Del)" }
    ],
    "EditPaste": [
      { "key": "V", "ctrl": true, "description": "Paste (text, or files/folders on panels)" },
      { "key": "Insert", "shift": true, "description": "Paste (Shift+Ins)" }
    ]
  }
}

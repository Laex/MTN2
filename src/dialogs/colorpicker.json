{
  "type": "dialog",
  "version": "2.0",
  "title": "Pick color",
  "width": 54,
  "height": 25,
  "children": [
    {
      "type": "colorpicker",
      "id": "picker",
      "col": 1,
      "row": 0,
      "width": 50,
      "height": 17
    },
    {
      "type": "separator",
      "col": 0,
      "row": 17,
      "width": 52,
      "height": 1
    },
    {
      "type": "label",
      "id": "hint",
      "text": "Arrows move, Shift+Left/Right by 10, Tab next",
      "col": 1,
      "row": 18,
      "width": 50,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 19,
      "width": 52,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "Use",
      "default": true,
      "col": 4,
      "row": 21,
      "width": 10,
      "height": 1
    },
    {
      "type": "button",
      "id": "clear",
      "text": "&Theme color",
      "col": 16,
      "row": 21,
      "width": 18,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 36,
      "row": 21,
      "width": 12,
      "height": 1
    }
  ]
}
{
  "type": "dialog",
  "version": "2.0",
  "title": "Checksums",
  "width": 44,
  "height": 9,
  "children": [
    {
      "type": "label",
      "id": "lbl_algo",
      "text": "Algorithm:",
      "col": 1,
      "row": 1,
      "width": 12,
      "height": 1
    },
    {
      "type": "dropdown",

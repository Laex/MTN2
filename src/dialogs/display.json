    {
      "type": "dropdown",
      "id": "language",
      "selected": 0,
      "items": [
        "English"
      ],
      "col": 13,
      "row": 16,
      "width": 20,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "OK",
      "default": true,
      "col": 11,
      "row": 18,
      "width": 12,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 29,
      "row": 18,
      "width": 12,
      "height": 1
    }

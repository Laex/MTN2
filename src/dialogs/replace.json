{
  "type": "dialog",
  "version": "2.0",
  "title": "Replace",
  "width": 60,
  "height": 14,
  "children": [
    {
      "type": "label",
      "text": "Find:",
      "id": "lbl_find",
      "col": 1,
      "row": 1,
      "width": 56,
      "height": 1
    },
    {
      "type": "input",
      "id": "find",
      "history": "editfind",
      "value": "",
      "col": 1,
      "row": 2,
      "width": 56,
      "height": 1
    },
    {
      "type": "label",
      "text": "Replace with:",
      "id": "lbl_replace",
      "col": 1,
      "row": 3,
      "width": 56,
      "height": 1
    },
    {
      "type": "input",
      "id": "replace",
      "history": "editreplace",
      "value": "",
      "col": 1,
      "row": 4,
      "width": 56,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "opt_case",
      "text": "&Case sensitive",
      "checked": false,
      "col": 1,
      "row": 6,
      "width": 27,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "opt_words",
      "text": "&Whole words",
      "checked": false,
      "col": 1,
      "row": 7,
      "width": 27,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "opt_regex",
      "text": "Reg&ular expressions",
      "checked": false,
      "col": 30,
      "row": 6,
      "width": 27,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "opt_reverse",
      "text": "Re&verse search",
      "checked": false,
      "col": 30,
      "row": 7,
      "width": 27,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 8,
      "width": 58,
      "height": 1
    },
    {
      "type": "button",
      "id": "one",
      "text": "Replace",
      "default": true,
      "col": 1,
      "row": 10,
      "width": 11,
      "height": 1
    },
    {
      "type": "button",
      "id": "all",
      "text": "&All",
      "col": 13,
      "row": 10,
      "width": 7,
      "height": 1
    },
    {
      "type": "button",
      "id": "word",
      "text": "Wo&rd",
      "col": 21,
      "row": 10,
      "width": 10,
      "height": 1
    },
    {
      "type": "button",
      "id": "selection",
      "text": "Se&lection",
      "col": 32,
      "row": 10,
      "width": 14,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 46,
      "row": 10,
      "width": 10,
      "height": 1
    }

{
  "type": "dialog",
  "version": "2.0",
  "title": "Import Obsidian theme",
  "width": 66,
  "height": 12,
  "children": [
    {
      "type": "label",
      "id": "lbl_path",
      "text": "Obsidian theme file (theme.css):",
      "col": 1,
      "row": 0,
      "width": 62,
      "height": 1
    },
    {
      "type": "input",
      "id": "obs_path",
      "value": "",
      "history": "obsidiantheme",
      "col": 1,
      "row": 1,
      "width": 62,
      "height": 1
    },
    {
      "type": "label",
      "id": "lbl_palette",
      "text": "Palette:",
      "col": 1,
      "row": 3,
      "width": 10,
      "height": 1
    },
    {
      "type": "dropdown",
      "id": "obs_palette",
      "selected": 0,
      "items": [
        "Dark",
        "Light"
      ],
      "col": 12,
      "row": 3,
      "width": 51
    },
    {
      "type": "label",
      "id": "status",
      "text": "",
      "col": 1,
      "row": 5,
      "width": 62,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 6,
      "width": 64,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "Import",
      "default": true,
      "col": 19,
      "row": 8,
      "width": 12,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 33,
      "row": 8,
      "width": 12,
      "height": 1
    }
  ]
}
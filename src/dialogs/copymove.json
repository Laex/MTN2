{
  "type": "dialog",
  "version": "2.0",
  "title": "Copy",
  "width": 76,
  "height": 15,
  "children": [
    {
      "type": "label",
      "text": "Copy to:",
      "id": "prompt",
      "col": 1,
      "row": 0,
      "width": 72,
      "height": 1
    },
    {
      "type": "input",
      "id": "job_dest",
      "history": "copydest",
      "value": "",
      "col": 1,
      "row": 1,
      "width": 72,
      "height": 1
    },
    {
      "type": "label",
      "text": "──────────────────────────────────────────────────────────────────────────",
      "col": 0,
      "row": 2,
      "width": 74,
      "height": 1
    },
    {
      "type": "label",
      "text": "Already existing files:",
      "col": 1,
      "row": 3,
      "width": 24,
      "height": 1
    },
    {
      "type": "dropdown",
      "id": "job_existing",
      "selected": 0,
      "items": [
        "Ask",
        "Overwrite",
        "Skip"
      ],
      "col": 26,
      "row": 3,
      "width": 20,
      "height": 1
    },
    {
      "type": "label",
      "text": "Retries on error:",
      "col": 1,
      "row": 4,
      "width": 18,
      "height": 1
    },
    {
      "type": "dropdown",
      "id": "job_retry",
      "selected": 1,
      "items": [
        "0",
        "1",
        "3"
      ],
      "col": 26,
      "row": 4,
      "width": 10,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "job_timestamps",
      "text": "Preserve all timestamps",
      "checked": false,
      "col": 1,
      "row": 5,
      "width": 36,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "job_only_newer",
      "text": "Only newer files",
      "checked": false,
      "col": 38,
      "row": 5,
      "width": 34,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "job_symlinks",
      "text": "Copy contents of symbolic links",
      "checked": false,
      "col": 1,
      "row": 6,
      "width": 72,
      "height": 1
    },
    {
      "type": "label",
      "text": "──────────────────────────────────────────────────────────────────────────",
      "col": 0,
      "row": 7,
      "width": 74,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "job_filter",
      "text": "Exclude mask:",
      "checked": false,
      "col": 1,
      "row": 8,
      "width": 16,
      "height": 1
    },
    {
      "type": "input",
      "id": "job_exclude",
      "history": "copyexclude",
      "value": "*.tmp;*.bak;~*",
      "col": 18,
      "row": 8,
      "width": 55,
      "height": 1
    },
    {
      "type": "label",
      "text": "──────────────────────────────────────────────────────────────────────────",
      "col": 0,
      "row": 9,
      "width": 74,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "Copy",
      "default": true,
      "col": 10,
      "row": 11,
      "width": 12,
      "height": 1
    },
    {
      "type": "button",
      "id": "background",
      "text": "Background",
      "col": 30,
      "row": 11,
      "width": 14,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 52,
      "row": 11,
      "width": 12,
      "height": 1
    }
  ]
}

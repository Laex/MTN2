{
  "type": "dialog",
  "version": "2.0",
  "title": "Find file",
  "width": 58,
  "height": 24,
  "children": [
    {
      "type": "label",
      "text": "A file mask or several file masks:",
      "id": "lbl_mask",
      "col": 1,
      "row": 0,
      "width": 54,
      "height": 1
    },
    {
      "type": "input",
      "id": "search_mask",
      "value": "*.*",
      "history": "findmask",
      "col": 1,
      "row": 1,
      "width": 54,
      "height": 1
    },
    {
      "type": "label",
      "text": "Containing text:",
      "id": "lbl_text",
      "col": 1,
      "row": 2,
      "width": 54,
      "height": 1
    },
    {
      "type": "input",
      "id": "search_text",
      "value": "",
      "history": "findtext",
      "col": 1,
      "row": 3,
      "width": 54,
      "height": 1
    },
    {
      "type": "label",
      "text": "Hex bytes:",
      "id": "lbl_hex",
      "col": 1,
      "row": 4,
      "width": 54,
      "height": 1
    },
    {
      "type": "input",
      "id": "search_hex",
      "value": "",
      "history": "findhex",
      "col": 1,
      "row": 5,
      "width": 54,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 6,
      "width": 56,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "search_case",
      "text": "&Case sensitive",
      "checked": false,
      "col": 1,
      "row": 7,
      "width": 22,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "search_words",
      "text": "&Whole words",
      "checked": false,
      "col": 27,
      "row": 7,
      "width": 28,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "search_folders",
      "text": "Search for &folders",
      "checked": false,
      "col": 1,
      "row": 8,
      "width": 25,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "search_regex",
      "text": "&Regex",
      "checked": false,
      "col": 27,
      "row": 8,
      "width": 28,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "search_subdirs",
      "text": "Search in &subfolders",
      "checked": true,
      "col": 1,
      "row": 9,
      "width": 54,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 10,
      "width": 56,
      "height": 1
    },
    {
      "type": "label",
      "text": "Size from:",
      "id": "lbl_size",
      "col": 1,
      "row": 11,
      "width": 15,
      "height": 1
    },
    {
      "type": "input",
      "id": "filter_size_min",
      "value": "",
      "col": 17,
      "row": 11,
      "width": 16,
      "height": 1
    },
    {
      "type": "label",
      "text": "to:",
      "id": "lbl_size_to",
      "col": 34,
      "row": 11,
      "width": 3,
      "height": 1
    },
    {
      "type": "input",
      "id": "filter_size_max",
      "value": "",
      "col": 38,
      "row": 11,
      "width": 16,
      "height": 1
    },
    {
      "type": "label",
      "text": "Modified from:",
      "id": "lbl_date",
      "col": 1,
      "row": 12,
      "width": 15,
      "height": 1
    },
    {
      "type": "input",
      "id": "filter_date_from",
      "value": "",
      "col": 17,
      "row": 12,
      "width": 16,
      "height": 1
    },
    {
      "type": "label",
      "text": "to:",
      "id": "lbl_date_to",
      "col": 34,
      "row": 12,
      "width": 3,
      "height": 1
    },
    {
      "type": "input",
      "id": "filter_date_to",
      "value": "",
      "col": 38,
      "row": 12,
      "width": 16,
      "height": 1
    },
    {
      "type": "label",
      "text": "Size: 10K, 1.5M",
      "id": "lbl_format",
      "col": 1,
      "row": 13,
      "width": 54,
      "height": 1
    },
    {
      "type": "label",
      "text": "Attributes:",
      "id": "lbl_attr",
      "col": 1,
      "row": 14,
      "width": 15,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "filter_attr_ro",
      "text": "Rea&d-only",
      "tristate": true,
      "unknown": true,
      "checked": false,
      "col": 17,
      "row": 14,
      "width": 24,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "filter_attr_hidden",
      "text": "&Hidden",
      "tristate": true,
      "unknown": true,
      "checked": false,
      "col": 17,
      "row": 15,
      "width": 24,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "filter_attr_system",
      "text": "Sys&tem",
      "tristate": true,
      "unknown": true,
      "checked": false,
      "col": 17,
      "row": 16,
      "width": 24,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "filter_attr_archive",
      "text": "&Archive",
      "tristate": true,
      "unknown": true,
      "checked": false,
      "col": 17,
      "row": 17,
      "width": 24,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 18,
      "width": 56,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "Find",
      "default": true,
      "col": 15,
      "row": 20,
      "width": 12,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 29,
      "row": 20,
      "width": 12,
      "height": 1
    }
  ]
}
{
  "type": "dialog",
  "version": "2.0",
  "title": "Split file",
  "width": 70,
  "height": 12,
  "children": [
    {
      "type": "label",
      "text": "Parts go to folder:",
      "id": "lbl_dest",
      "col": 1,
      "row": 0,
      "width": 66,
      "height": 1
    },
    {
      "type": "input",
      "id": "dest",
      "value": "",
      "col": 1,
      "row": 1,
      "width": 66,
      "height": 1,
      "history": "splitdest"
    },
    {
      "type": "label",
      "text": "Part size (for example 700M, 1.44M, 4G, 65536):",
      "id": "lbl_size",
      "col": 1,
      "row": 3,
      "width": 66,
      "height": 1
    },
    {
      "type": "input",
      "id": "size",
      "value": "",
      "col": 1,
      "row": 4,
      "width": 66,
      "height": 1,
      "history": "splitsize"
    },
    {
      "type": "separator",
      "col": 0,
      "row": 6,
      "width": 68,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "Split",
      "default": true,
      "col": 19,
      "row": 8,
      "width": 14,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 35,
      "row": 8,
      "width": 14,
      "height": 1
    }
  ]
}

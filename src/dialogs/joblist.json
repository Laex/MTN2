{
  "type": "dialog",
  "version": "2.0",
  "title": "Background jobs",
  "width": 72,
  "height": 20,
  "children": [
    {
      "type": "label",
      "id": "header",
      "text": "Job                                              Progress",
      "col": 1,
      "row": 0,
      "width": 68,
      "height": 1
    },
    {
      "type": "list",
      "id": "jobs",
      "selected": 0,
      "items": [
        "(no jobs)"
      ],
      "col": 1,
      "row": 1,
      "width": 68,
      "height": 10
    },
    {
      "type": "separator",
      "col": 0,
      "row": 12,
      "width": 70,
      "height": 1
    },
    {
      "type": "label",
      "id": "after_label",
      "text": "When the queue ends:",
      "col": 1,
      "row": 11,
      "width": 21,
      "height": 1
    },
    {
      "type": "dropdown",
      "id": "after_queue",
      "selected": 0,
      "items": [
        "Do nothing",
        "Sleep",
        "Shut down",
        "Close the program"
      ],
      "col": 23,
      "row": 11,
      "width": 45,
      "height": 1
    },
    {
      "type": "button",
      "id": "pausejob",
      "text": "&Pause",
      "col": 4,
      "row": 14,
      "width": 14,
      "height": 1
    },
    {
      "type": "button",
      "id": "jobup",
      "text": "&Up",
      "col": 20,
      "row": 14,
      "width": 14,
      "height": 1
    },
    {
      "type": "button",
      "id": "jobdown",
      "text": "Do&wn",
      "col": 36,
      "row": 14,
      "width": 14,
      "height": 1
    },
    {
      "type": "button",
      "id": "jobspeed",
      "text": "&Speed",
      "col": 52,
      "row": 14,
      "width": 14,
      "height": 1
    },
    {
      "type": "button",
      "id": "foreground",
      "text": "Foreground",
      "default": true,
      "col": 4,
      "row": 16,
      "width": 14,
      "height": 1
    },
    {
      "type": "button",
      "id": "canceljob",
      "text": "&Cancel",
      "col": 20,
      "row": 16,
      "width": 14,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancelall",
      "text": "Cancel &all",
      "col": 36,
      "row": 16,
      "width": 14,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Close",
      "cancel": true,
      "col": 52,
      "row": 16,
      "width": 14,
      "height": 1
    }
  ]
}
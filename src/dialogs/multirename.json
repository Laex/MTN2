      "col": 58,
      "row": 3,
      "width": 11,
      "height": 1
    },
    {
      "type": "input",
      "id": "replace",
      "value": "",
      "col": 70,
      "row": 3,
      "width": 40,
      "height": 1
    },
    {
      "type": "label",
      "id": "lbl_counter",
      "text": "Counter from:",

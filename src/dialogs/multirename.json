{
  "type": "dialog",
  "version": "2.0",
  "title": "Multi-rename",
  "width": 114,
  "height": 29,
  "children": [
    {
      "type": "label",
      "id": "lbl_name_mask",
      "text": "Name mask:",
      "col": 1,
      "row": 1,
      "width": 14,
      "height": 1
    },
    {
      "type": "input",
      "id": "name_mask",
      "value": "[N]",
      "col": 16,
      "row": 1,
      "width": 40,
      "height": 1
    },
    {
      "type": "label",
      "id": "lbl_ext_mask",
      "text": "Extension:",
      "col": 58,
      "row": 1,
      "width": 11,
      "height": 1
    },
    {
      "type": "input",
      "id": "ext_mask",
      "value": "[E]",
      "col": 70,
      "row": 1,
      "width": 40,
      "height": 1
    },
    {
      "type": "label",
      "id": "lbl_search",
      "text": "Search:",
      "col": 1,
      "row": 3,
      "width": 14,
      "height": 1

    {
      "type": "button",
      "id": "ok",
      "text": "Rename",
      "default": true,
      "col": 45,
      "row": 25,
      "width": 12,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 59,
      "row": 25,
      "width": 12,
      "height": 1

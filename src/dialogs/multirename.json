    {
      "type": "input",
      "id": "c_step",
      "value": "1",
      "col": 31,
      "row": 5,
      "width": 5,
      "height": 1
    },
    {
      "type": "label",
      "id": "lbl_digits",
      "text": "digits:",
      "col": 38,
      "row": 5,
      "width": 7,
      "height": 1
    },
    {
      "type": "input",
      "id": "c_digits",
      "value": "1",
      "col": 46,
      "row": 5,
      "width": 4,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "match_case",
      "text": "Match &case",
      "checked": false,
      "col": 58,
      "row": 5,
      "width": 30,
      "height": 1
    },
    {
      "type": "label",
      "id": "lbl_case",
      "text": "Letter case:",
      "col": 1,
      "row": 7,
      "width": 14,
      "height": 1
    },
    {
      "type": "dropdown",
      "id": "case_mode",
      "selected": 0,
      "items": [
        "Unchanged",
        "lower case",
        "UPPER CASE",
        "First letter upper",
        "Each Word Upper"
      ],
      "col": 16,
      "row": 7,
      "width": 40,
      "height": 1
    },
    {
      "type": "label",
      "id": "status",
      "text": "",
      "col": 1,
      "row": 9,
      "width": 110,
      "height": 1
    },
    {
      "type": "label",
      "id": "columns",
      "text": "",
      "col": 1,
      "row": 10,
      "width": 110,
      "height": 1

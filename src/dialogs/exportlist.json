{
  "type": "dialog",
  "version": "2.0",
  "title": "Export list",
  "width": 72,
  "height": 18,
  "children": [
    {
      "type": "label",
      "id": "prompt",
      "text": "Save the list to the file:",
      "col": 1,
      "row": 0,
      "width": 68,
      "height": 1
    },
    {
      "type": "input",
      "id": "name",
      "value": "",
      "history": "exportlist",
      "col": 1,
      "row": 1,
      "width": 68,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 2,
      "width": 70,
      "height": 1
    },
    {
      "type": "label",
      "id": "format_lbl",
      "text": "Format:",
      "col": 1,
      "row": 3,
      "width": 68,
      "height": 1
    },
    {
      "type": "radio",
      "id": "fmt_auto",
      "group": "format",
      "text": "A&uto (by extension)",
      "checked": true,
      "col": 1,
      "row": 4,
      "width": 33,
      "height": 1
    },
    {
      "type": "radio",
      "id": "fmt_text",
      "group": "format",
      "text": "Pla&in text",
      "checked": false,
      "col": 35,
      "row": 4,
      "width": 33,
      "height": 1
    },
    {
      "type": "radio",
      "id": "fmt_md",
      "group": "format",
      "text": "Mar&kdown",
      "checked": false,
      "col": 1,
      "row": 5,
      "width": 33,
      "height": 1
    },
    {
      "type": "radio",
      "id": "fmt_csv",
      "group": "format",
      "text": "CS&V",
      "checked": false,
      "col": 35,
      "row": 5,
      "width": 33,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "header",
      "text": "&Header line",
      "checked": true,
      "col": 1,
      "row": 6,
      "width": 34,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 7,
      "width": 70,
      "height": 1
    },
    {
      "type": "label",
      "id": "fields_lbl",
      "text": "Fields:",
      "col": 1,
      "row": 8,
      "width": 68,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "f_name",
      "text": "&Name",
      "checked": true,
      "col": 1,
      "row": 9,
      "width": 22,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "f_path",
      "text": "&Full path",
      "checked": false,
      "col": 24,
      "row": 9,
      "width": 22,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "f_ext",
      "text": "&Extension",
      "checked": false,
      "col": 47,
      "row": 9,
      "width": 22,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "f_size",
      "text": "&Size",
      "checked": true,
      "col": 1,
      "row": 10,
      "width": 22,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "f_modified",
      "text": "&Modified date",
      "checked": true,
      "col": 24,
      "row": 10,
      "width": 22,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "f_created",
      "text": "&Created date",
      "checked": false,
      "col": 47,
      "row": 10,
      "width": 22,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "f_accessed",
      "text": "&Accessed date",
      "checked": false,
      "col": 1,
      "row": 11,
      "width": 22,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "f_type",
      "text": "&Type",
      "checked": false,
      "col": 24,
      "row": 11,
      "width": 22,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "f_attr",
      "text": "Attri&butes",
      "checked": false,
      "col": 47,
      "row": 11,
      "width": 22,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 12,
      "width": 70,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "OK",
      "default": true,
      "col": 24,
      "row": 14,
      "width": 10,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 36,
      "row": 14,
      "width": 10,
      "height": 1
    }
  ]
}

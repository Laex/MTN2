{
  "type": "dialog",
  "version": "2.0",
  "title": "Select",
  "width": 48,
  "height": 12,
  "children": [
    {
      "type": "label",
      "text": "Prompt:",
      "id": "prompt",
      "col": 1,
      "row": 0,
      "width": 44,
      "height": 1
    },
    {
      "type": "input",
      "id": "name",
      "history": "masks",
      "value": "*.*",
      "col": 1,
      "row": 1,
      "width": 44,
      "height": 1
    },
    {
      "type": "label",
      "id": "group_label",
      "text": "Save as mask group (optional):",
      "col": 1,
      "row": 3,
      "width": 44,
      "height": 1
    },
    {
      "type": "input",
      "id": "group_name",
      "value": "",
      "col": 1,
      "row": 4,
      "width": 44,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "select_folders",
      "text": "&Select folders",
      "checked": false,
      "col": 1,
      "row": 5,
      "width": 44,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 6,
      "width": 46,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "OK",
      "default": true,
      "col": 12,
      "row": 8,
      "width": 10,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 24,
      "row": 8,
      "width": 10,
      "height": 1
    }
  ]
}
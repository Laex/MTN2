{
  "type": "dialog",
  "version": "2.0",
  "title": "External Viewer / Editor",
  "width": 72,
  "height": 14,
  "children": [
    {
      "type": "label",
      "id": "lbl_viewer",
      "text": "Viewer (Alt+F3):",
      "col": 1,
      "row": 1,
      "width": 68,
      "height": 1
    },
    {
      "type": "input",
      "id": "viewer",
      "value": "",
      "col": 1,
      "row": 2,
      "width": 68,
      "height": 1
    },
    {
      "type": "label",
      "id": "lbl_editor",
      "text": "Editor (Alt+F4):",
      "col": 1,
      "row": 4,
      "width": 68,
      "height": 1
    },
    {
      "type": "input",
      "id": "editor",
      "value": "",
      "col": 1,
      "row": 5,
      "width": 68,
      "height": 1
    },
    {
      "type": "label",
      "id": "help1",
      "text": "%1 - file path; without %1 the path is added at the end",
      "col": 1,
      "row": 7,
      "width": 68,
      "height": 1
    },
    {
      "type": "label",
      "id": "help2",
      "text": "Empty: the Windows program for the file (editor: Edit, else Notepad)",
      "col": 1,
      "row": 8,
      "width": 68,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "OK",
      "default": true,
      "col": 18,
      "row": 10,
      "width": 14,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 40,
      "row": 10,
      "width": 14,
      "height": 1
    }
  ]
}

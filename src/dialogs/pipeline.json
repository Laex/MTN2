{
  "type": "dialog",
  "version": "2.0",
  "title": "Search pipeline",
  "width": 72,
  "height": 14,
  "children": [
    {
      "type": "label",
      "text": "1. Find files (name, size, date):",
      "id": "lbl_pipe_names",
      "col": 1,
      "row": 0,
      "width": 68,
      "height": 1
    },
    {
      "type": "dropdown",
      "id": "pipe_names",
      "selected": 0,
      "items": [
        "Auto",
        "Built-in"
      ],
      "col": 1,
      "row": 1,
      "width": 30,
      "height": 1
    },
    {
      "type": "label",
      "text": "2. Check the text in the found files:",
      "id": "lbl_pipe_text",
      "col": 1,
      "row": 3,
      "width": 68,
      "height": 1
    },
    {
      "type": "dropdown",
      "id": "pipe_text",
      "selected": 0,
      "items": [
        "Auto",
        "Built-in"
      ],
      "col": 1,
      "row": 4,
      "width": 30,
      "height": 1
    },
    {
      "type": "label",
      "text": "Both stages run when a text is searched with a selective mask.",
      "id": "lbl_pipe_note",
      "col": 1,
      "row": 6,
      "width": 68,
      "height": 2
    },
    {
      "type": "separator",
      "col": 0,
      "row": 8,
      "width": 70,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "OK",
      "default": true,
      "col": 21,
      "row": 10,
      "width": 12,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 37,
      "row": 10,
      "width": 12,
      "height": 1
    }
  ]
}

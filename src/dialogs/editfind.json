{
  "type": "dialog",
  "version": "2.0",
  "title": "Search",
  "width": 60,
  "height": 11,
  "children": [
    {
      "type": "label",
      "text": "Find:",
      "id": "lbl_find",
      "col": 1,
      "row": 0,
      "width": 56,
      "height": 1
    },
    {
      "type": "input",
      "id": "find",
      "history": "editfind",
      "value": "",
      "col": 1,
      "row": 1,
      "width": 56,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "opt_case",
      "text": "&Case sensitive",
      "checked": false,
      "col": 1,
      "row": 3,
      "width": 27,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "opt_words",
      "text": "&Whole words",
      "checked": false,
      "col": 1,
      "row": 4,
      "width": 27,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "opt_regex",
      "text": "Reg&ular expressions",
      "checked": false,
      "col": 30,
      "row": 3,
      "width": 27,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "opt_reverse",
      "text": "Re&verse search",
      "checked": false,
      "col": 30,
      "row": 4,
      "width": 27,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 5,
      "width": 58,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "Search",
      "default": true,
      "col": 3,
      "row": 7,
      "width": 12,
      "height": 1
    },
    {
      "type": "button",
      "id": "word",
      "text": "Wo&rd",
      "col": 17,
      "row": 7,
      "width": 10,
      "height": 1
    },
    {
      "type": "button",
      "id": "selection",
      "text": "Se&lection",
      "col": 29,
      "row": 7,
      "width": 14,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 45,
      "row": 7,
      "width": 10,
      "height": 1
    }
  ]
}

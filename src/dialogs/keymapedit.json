{
  "type": "dialog",
  "version": "2.0",
  "title": "Edit hotkeys",
  "width": 70,
  "height": 14,
  "children": [
    {
      "type": "label",
      "id": "km_action",
      "text": "Action:",
      "col": 1,
      "row": 1,
      "width": 64,
      "height": 1
    },
    {
      "type": "label",
      "text": "Hotkeys:",
      "col": 1,
      "row": 3,
      "width": 10,
      "height": 1
    },
    {
      "type": "input",
      "id": "km_keys",
      "value": "",
      "col": 12,
      "row": 3,
      "width": 56,
      "height": 1
    },
    {
      "type": "label",
      "text": "Separate multiple combos with ';', e.g. Ctrl+C; F5",
      "col": 1,
      "row": 5,
      "width": 64,
      "height": 1
    },
    {
      "type": "label",
      "text": "Modifiers: Ctrl+ Alt+ Shift+ (e.g. Ctrl+Shift+F5, Alt+F7)",
      "col": 1,
      "row": 6,
      "width": 64,
      "height": 1
    },
    {
      "type": "label",
      "id": "km_status",
      "text": "",
      "col": 1,
      "row": 8,
      "width": 64,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "OK",
      "default": true,
      "col": 14,
      "row": 10,
      "width": 12,
      "height": 1
    },
    {
      "type": "button",
      "id": "reset",
      "text": "Reset",
      "col": 28,
      "row": 10,
      "width": 12,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 42,
      "row": 10,
      "width": 12,
      "height": 1
    }
  ]
}

{
  "type": "dialog",
  "version": "2.0",
  "title": "Go to line",
  "width": 36,
  "height": 8,
  "children": [
    {
      "type": "label",
      "text": "Line number:",
      "col": 1,
      "row": 1,
      "width": 32,
      "height": 1
    },
    {
      "type": "input",
      "id": "line",
      "value": "1",
      "col": 1,
      "row": 2,
      "width": 32,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "OK",
      "default": true,
      "col": 6,
      "row": 4,
      "width": 10,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 18,
      "row": 4,
      "width": 10,
      "height": 1
    }
  ]
}
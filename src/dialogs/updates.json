{
  "type": "dialog",
  "version": "2.0",
  "title": "Updates",
  "width": 58,
  "height": 10,
  "children": [
    {
      "type": "label",
      "text": "",
      "id": "version",
      "col": 1,
      "row": 1,
      "width": 54,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "check_on_start",
      "text": "&Check for updates at startup",
      "checked": true,
      "col": 1,
      "row": 3,
      "width": 54,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "show_check_notice",
      "text": "&Show a notice when checking",
      "checked": true,
      "col": 1,
      "row": 4,
      "width": 54,
      "height": 1
    },
    {
      "type": "button",
      "id": "check",
      "text": "Check now",
      "default": true,
      "col": 10,
      "row": 6,
      "width": 18,
      "height": 1
    },
    {
      "type": "button",
      "id": "close",
      "text": "Close",
      "cancel": true,
      "col": 30,
      "row": 6,
      "width": 18,
      "height": 1
    }
  ]
}

{
  "type": "dialog",
  "version": "2.0",
  "title": "Plugin permissions",
  "width": 74,
  "height": 13,
  "children": [
    {
      "type": "label",
      "text": "The plugin asks to be allowed to:",
      "id": "intro",
      "col": 1,
      "row": 0,
      "width": 70,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "perm_override",
      "text": "&Replace",
      "checked": false,
      "col": 1,
      "row": 2,
      "width": 70,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "perm_0",
      "text": "&Permission",
      "checked": false,
      "col": 1,
      "row": 3,
      "width": 70,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "perm_1",
      "text": "Perm&ission",
      "checked": false,
      "col": 1,
      "row": 4,
      "width": 70,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 5,
      "width": 72,
      "height": 1
    },
    {
      "type": "label",
      "text": "Replacing built-in handlers reloads the plugin at once.",
      "id": "hint",
      "col": 1,
      "row": 6,
      "width": 70,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 7,
      "width": 72,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "  OK  ",
      "default": true,
      "col": 48,
      "row": 9,
      "width": 10,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 60,
      "row": 9,
      "width": 10,
      "height": 1
    }
  ]
}

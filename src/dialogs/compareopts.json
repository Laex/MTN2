{
  "type": "dialog",
  "version": "2.0",
  "title": "Compare folders",
  "width": 44,
  "height": 11,
  "children": [
    {
      "type": "label",
      "id": "lbl_compare",
      "text": "Compare:",
      "col": 1,
      "row": 0,
      "width": 40,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "by_time",
      "text": "&Time",
      "checked": true,
      "col": 3,
      "row": 1,
      "width": 38,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "by_size",
      "text": "&Size",
      "checked": true,
      "col": 3,
      "row": 2,
      "width": 38,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "by_content",
      "text": "&Content",
      "checked": false,
      "col": 3,
      "row": 3,
      "width": 38,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 5,
      "width": 42,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "OK",
      "default": true,
      "col": 8,
      "row": 7,
      "width": 12,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 22,
      "row": 7,
      "width": 12,
      "height": 1
    }
  ]
}
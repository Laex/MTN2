{
  "type": "dialog",
  "version": "2.0",
  "title": "File Association",
  "width": 60,
  "height": 14,
  "children": [
    {
      "type": "label",
      "text": "Extension:",
      "col": 1,
      "row": 1,
      "width": 16,
      "height": 1
    },
    {
      "type": "input",
      "id": "extension",
      "value": "",
      "col": 18,
      "row": 1,
      "width": 20,
      "height": 1
    },
    {
      "type": "label",
      "text": "Action:",
      "col": 1,
      "row": 3,
      "width": 16,
      "height": 1
    },
    {
      "type": "dropdown",
      "id": "action",
      "selected": 0,
      "items": [
        "View",
        "Edit",
        "Shell (OS open)",
        "Run command"
      ],
      "col": 18,
      "row": 3,
      "width": 34,
      "height": 1
    },
    {
      "type": "label",
      "text": "Command (%1 = file, Run command only):",
      "col": 1,
      "row": 5,
      "width": 56,
      "height": 1
    },
    {
      "type": "input",
      "id": "command",
      "value": "",
      "col": 1,
      "row": 6,
      "width": 56,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "OK",
      "default": true,
      "col": 11,
      "row": 10,
      "width": 14,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 33,
      "row": 10,
      "width": 14,
      "height": 1
    }
  ]
}

{
  "type": "dialog",
  "version": "2.0",
  "title": "Console",
  "width": 56,
  "height": 14,
  "children": [
    {
      "type": "label",
      "id": "lbl_scrollback",
      "text": "Scrollback",
      "col": 1,
      "row": 0,
      "width": 16,
      "height": 1
    },
    {
      "type": "dropdown",
      "id": "scrollback",
      "selected": 2,
      "items": [
        "1000 lines",
        "5000 lines",
        "10000 lines",
        "25000 lines",
        "50000 lines"
      ],
      "col": 18,
      "row": 0,
      "width": 18,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "confirm_paste",
      "text": "Confirm &multi-line paste",
      "checked": false,
      "col": 1,
      "row": 2,
      "width": 52,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "trim_copy",
      "text": "Trim spaces at line ends on &copy",
      "checked": false,
      "col": 1,
      "row": 3,
      "width": 52,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "trim_paste",
      "text": "Trim spaces at line ends on &paste",
      "checked": false,
      "col": 1,
      "row": 4,
      "width": 52,
      "height": 1
    },
    {
      "type": "checkbox",
      "id": "return_panels",
      "text": "Always &return to the panels when a command ends",
      "checked": false,
      "col": 1,
      "row": 5,
      "width": 52,
      "height": 1
    },
    {
      "type": "label",
      "id": "lbl_bg_show",
      "text": "Background run:",
      "col": 1,
      "row": 7,
      "width": 16,
      "height": 1
    },
    {
      "type": "dropdown",
      "id": "bg_show",
      "selected": 2,
      "items": [
        "0.5 s",
        "1 s",
        "2 s",
        "3 s",
        "5 s",
        "10 s"
      ],
      "col": 18,
      "row": 7,
      "width": 12,
      "height": 1
    },
    {
      "type": "separator",
      "col": 0,
      "row": 8,
      "width": 54,
      "height": 1
    },
    {
      "type": "button",
      "id": "ok",
      "text": "OK",
      "default": true,
      "col": 14,
      "row": 10,
      "width": 12,
      "height": 1
    },
    {
      "type": "button",
      "id": "cancel",
      "text": "Cancel",
      "cancel": true,
      "col": 29,
      "row": 10,
      "width": 12,
      "height": 1
    }
  ]
}
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{FAC743AF-D861-4FBB-AD81-4795398BBE41}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="..\MTN2.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="DialogDesigner\DialogDesigner.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="MTN2">
        <MSBuild Projects="..\MTN2.dproj"/>
    </Target>
    <Target Name="MTN2:Clean">
        <MSBuild Projects="..\MTN2.dproj" Targets="Clean"/>
    </Target>
    <Target Name="MTN2:Make">
        <MSBuild Projects="..\MTN2.dproj" Targets="Make"/>
    </Target>
    <Target Name="DialogDesigner">
        <MSBuild Projects="DialogDesigner\DialogDesigner.dproj"/>
    </Target>
    <Target Name="DialogDesigner:Clean">
        <MSBuild Projects="DialogDesigner\DialogDesigner.dproj" Targets="Clean"/>
    </Target>
    <Target Name="DialogDesigner:Make">
        <MSBuild Projects="DialogDesigner\DialogDesigner.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="MTN2;DialogDesigner"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="MTN2:Clean;DialogDesigner:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="MTN2:Make;DialogDesigner:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>

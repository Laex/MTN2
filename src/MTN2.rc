/* No VERSIONINFO here: msbuild stamps it into MTN2.res from MTN2.dproj
   (VerInfo_*), and build.ps1 -Version overrides that from the release tag. */

MAINICON ICON "Assets\\MTN2.ico"

/* Panel icon for parent directory ("..") */
ICON_PARENT_UP RCDATA "Assets\\parent_up.png"

/* Top menu bar layout - edit config\menu.json, loaded via uTopMenuBar.LoadMenuFromResource */
MENU_MAIN RCDATA "config\\menu.json"

/* Default hotkey profile - edit keymap.json, loaded via uKeymap.LoadDefaultKeymapProfile.
   A user keymap.json in the config dir overrides individual hotkeys on top of this. */
KEYMAP_DEFAULT RCDATA "keymap.json"

/* Built-in themes (read-only) - edit Assets\themes\*.theme.json. A theme file
   lists what it sets and "extends" another theme for the rest; the user's own
   themes live in <config dir>\themes. See uThemeSpec / uThemeRegistry. */
THEME_NDN RCDATA "Assets\\themes\\NDN.theme.json"
THEME_MODERNUNICODE RCDATA "Assets\\themes\\ModernUnicode.theme.json"
THEME_ASCII RCDATA "Assets\\themes\\ASCII.theme.json"
THEME_TOTALCOMMANDER RCDATA "Assets\\themes\\TotalCommander.theme.json"
THEME_SOLARIZEDDARK RCDATA "Assets\\themes\\SolarizedDark.theme.json"
THEME_DRACULA RCDATA "Assets\\themes\\Dracula.theme.json"
THEME_NORD RCDATA "Assets\\themes\\Nord.theme.json"
THEME_HIGHCONTRAST RCDATA "Assets\\themes\\HighContrast.theme.json"


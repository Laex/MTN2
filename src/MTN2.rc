1 VERSIONINFO
FILEVERSION 0,1,14,0
PRODUCTVERSION 0,1,14,0
FILEFLAGSMASK 0x3FL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "MTN2"
      VALUE "FileDescription", "Modern Terminal Navigator 2"
      VALUE "FileVersion", "0.1.14.0"
      VALUE "InternalName", "MTN2"
      VALUE "OriginalFilename", "MTN2.exe"
      VALUE "ProductName", "Modern Terminal Navigator 2"
      VALUE "ProductVersion", "0.1.14"
      VALUE "Comments", "v0.1.14 MVP daily local + UX polish"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

MAINICON ICON "Assets\\MTN2.ico"

/* Panel icon for parent directory ("..") */
ICON_PARENT_UP RCDATA "Assets\\parent_up.png"

/* Top menu bar layout — edit config\menu.json, loaded via uTopMenuBar.LoadMenuFromResource */
MENU_MAIN RCDATA "config\\menu.json"

/* Default hotkey profile — edit keymap.json, loaded via uKeymap.LoadDefaultKeymapProfile.
   A user keymap.json in the config dir overrides individual hotkeys on top of this. */
KEYMAP_DEFAULT RCDATA "keymap.json"

/* Default (NDN) theme — edit NDNtheme.json's "fileColoring" (panel color-
   coding rules; colors are theme-owned — pick them to not clash with this
   theme's own selection/cursor palette). A theme file in the config dir
   (named by TMtnSession.ThemeFile, e.g. FARtheme.json — 'NDNtheme.json'
   when unspecified) merges on top by group Name
   (uColorCoding.MergeColorCodingGroups / ReloadColorCoding), so it only
   needs to list the groups it adds or changes. */
THEME_DEFAULT RCDATA "NDNtheme.json"

